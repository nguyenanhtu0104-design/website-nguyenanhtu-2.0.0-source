  "nguyenNhan": "Tổng mặt bằng là bản vẽ tiếp thị, không vẽ đúng một tỷ lệ bên trong. Một phép chiếu chung khớp được khu giữa thì khu rìa vẫn lệch.",
  "cachDutDiem": "Xin bản đồ quy hoạch tổng mặt bằng 1/500 có bảng toạ độ VN-2000 (kinh tuyến trục 107°45′, EPSG:5899) rồi chạy lệnh vn2000 đổi ra mốc.",
  "capNhat": "2.41.0: không còn dùng một phép chiếu chung cho cả khu. Từng khối đặt theo ghim thật, xem mục khoi; các dòng theoKhu dưới đây là kết quả của phép chiếu chung trước khi tách khối."
 },
 "khoi": {
  "nguyenTac": "Tổng mặt bằng là bản vẽ tiếp thị: nén theo chiều dọc (khối vẽ sâu 12–15 đơn vị, thực tế 18–20) và lệch từng cụm, nên dán cả tấm lên bản đồ thì càng xuống phía nam càng lệch, có dãy nằm đè lên đường. Vì vậy tách từng khối nhà (căn hộ, song lập, đơn lập, Grand Villa, nhà phố) rồi đặt mỗi khối theo ghim thật của nó. Nền Tổng mặt bằng: khối nằm theo bản vẽ. Nền bản đồ và Chồng lớp: khối nằm theo ghim.",
  "cachDoc": "ds: mỗi khối có khung (chọn lô trong geometry.json theo khung và loại), tamBanVe (tâm khối trên bản vẽ), ghim (vĩ độ, kinh độ tâm khối thật), tyLe (hệ số giãn ngang, dọc so với bản vẽ). Lô thật = ghim + (lô bản vẽ − tamBanVe) × tyLe. ghim null: giữ theo phép chiếu chung. thap: như trên cho khối tháp (khungBanVe là hộp bao chân tháp trong chan-thap.json, hoặc tamBanVe của tháp cụm B).",
  "ngayDo": "2026-11-19",
  "anhDo": "Esri World Imagery z18 (0,59 m mỗi điểm ảnh), đưa về khung bản vẽ bằng phép chiếu chung",
  "congCu": "scripts/khop-sa-ban.py tach / do / dat / nghiemthu",
  "cachDo": "Đọc tâm hai dãy nhà và đầu khối trên ảnh có lưới đo; dò tự động trong ±5 đơn vị quanh số đọc tay (lệnh do); soát bằng mắt từng khối trước và sau, chỉ nhận gợi ý khi thấy khớp hơn. Gợi ý bị loại ở nhà phố, song lập phía Đông và K29 (dãy đều nhau, đường nhựa tối làm máy bắt nhầm). Khối chưa xây (K06, K14, K15, K32) suy theo bước khối bên cạnh. Tháp Beacon, Beachtro theo hố móng có hệ chống thép; B1 theo hố móng; B2, B3, B5, B6, B7 chưa xây, suy theo bước.",
  "nghiemThu": {
   "ketQua": "Cả bốn ghim căn Tú đặt đều rơi đúng lô cùng mã (lô gần ghim nhất), lệch 1,8–7,9 m, trước khi tách khối lệch 38–118 m. Tâm hố móng Beacon và Beachtro đo trên ảnh trùng ghim tâm Tú đặt độc lập, lệch 6,6 m và 2,8 m.",
   "khoiDaXay": 32,
   "doPhuTrungBinh": {
    "truoc": 0.54,
    "sau": 0.81
   },
   "doPhuGhiChu": "Độ phủ = tỷ lệ diện tích thân nhà mô hình nằm trên công trình thật (sàn bê tông, mái, khung đang đổ). Chỉ số phụ: Grand Villa mới đổ sàn nhỏ hơn hộp thân nhà nên phủ thấp dù đã khớp (K29); số \"trước\" của vài khối cao vì mô hình đè nhầm lên khối bên cạnh.",
   "chuaKiem": "K00–K04 song lập phía Tây xa: bãi san lấp, chưa có dấu vết nền móng, giữ theo phép chiếu chung. K06, K14, K15, K32 và tháp B2, B3, B5, B6, B7 chưa xây: vị trí suy theo bước, phải đo lại khi có móng.",
   "canLamTiep": "Bảng toạ độ VN-2000 trong quy hoạch 1/500 sẽ thay toàn bộ ghim đo trên ảnh. Có thêm ghim căn của Tú ở khu chưa xây thì đặt lại các khối đó theo ghim."
  },
